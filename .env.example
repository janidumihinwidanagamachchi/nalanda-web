# Embed credentials
#
# None of these are required for the site to build or run. Every social embed
# degrades to a designed link card when its credential is absent, so the site
# never renders an empty third-party frame.
#
# The YouTube embed is the exception: it needs no credentials at all. It reads
# the channel's public RSS feed at build time. See src/lib/youtube.ts.

# Instagram
# Requires a Meta app with Instagram Basic Display or Graph API access, plus
# App Review approval. Without it, /channels renders the Instagram link cards.
NEXT_PUBLIC_INSTAGRAM_TOKEN=

# Facebook
# Requires a Meta app ID for the Page Plugin, and a verified domain that
# matches the deployment host. Without it, /channels renders the Facebook
# link cards.
NEXT_PUBLIC_FB_APP_ID=

# Buttondown
# The username from your Buttondown address, which looks like
# `nalanda` for nalanda@buttondown.email. The newsletter widget posts its form
# straight to Buttondown, so this needs no API key and no backend.
# Without it, the widget shows a link to /newsletter instead of a signup box.
NEXT_PUBLIC_BUTTONDOWN_USER=

# Supabase (content administration)
#
# Optional. The site builds, prerenders and serves every public page without
# them, using the content in src/data as it was seeded — which is the point:
# a fork with no database is still a working site.
#
# With them set:
#   * /admin signs staff in and edits announcements, news and photographs.
#   * CONTENT_SOURCE=supabase reads the database at build time instead of src/data.
#
# The anon key is designed to be public. It is named `anon` by Supabase because it
# is the key every visitor's browser holds; what it can do is bounded entirely by
# the row-level security policies in supabase/migrations. Never add a service-role
# key here — this is a static site, so every NEXT_PUBLIC_ value is in the bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which source the public site reads at build time.
#
#   static    (default) src/data, with no network access. Reproducible, and the
#             right choice for local work and for preview builds.
#   supabase  the database. A read failure fails the build rather than silently
#             publishing the static fallback, so a broken database cannot quietly
#             ship a stale site.
#
# Note this only affects the *public* site. /admin always talks to the database
# directly, whatever this is set to.
CONTENT_SOURCE=static
